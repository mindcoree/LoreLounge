# ─── Profile Service — Application Config ───────────────────────────────────────
# Этот файл читается:
#   1. Локально — pydantic-settings через dotenv
#   2. В Docker — через env_file в docker-compose.yml
#
# ❌ НЕ КОММИТЬ этот файл в git (он в .gitignore)
#    Используй .env.example как шаблон для команды

# ── База данных ───────────────────────────────────────────────────────────────
# Для локальной разработки (без Docker) — localhost на порту 5433
# В Docker — docker-compose подставит отдельные поля через environment:
# PROFILE_CONFIG__DB__POSTGRES_USER=profile_admin
# PROFILE_CONFIG__DB__POSTGRES_PASSWORD=profile_secret
# PROFILE_CONFIG__DB__POSTGRES_SERVER=localhost
# PROFILE_CONFIG__DB__POSTGRES_PORT=5433
# PROFILE_CONFIG__DB__POSTGRES_DB=lorelounge_profile


# ── MinIO (локально) ─────────────────────────────────────────────────────────
# Для запуска profile вне Docker указывай localhost.
# В Docker эти значения переопределяются из infra/docker-compose.yml.
PROFILE_CONFIG__MINIO__ENDPOINT=localhost:9000
PROFILE_CONFIG__MINIO__ACCESS_KEY=admin
PROFILE_CONFIG__MINIO__SECRET_KEY=SuperSecret123!
PROFILE_CONFIG__MINIO__USE_SSL=false
PROFILE_CONFIG__MINIO__BUCKET_NAME=lorelounge-media
PROFILE_CONFIG__MINIO__BASE_PATH=profile


# ── Infrastructure ───────────────────────────────────────────────────────────
PROFILE_CONFIG__RUN__SHOW_DOCS=true

# ── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
