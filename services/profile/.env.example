# ─── Profile Service — Application Config (ШАБЛОН) ────────────────────────────
# Скопируй этот файл в .env и заполни значения:
#   cp services/profile/.env.example services/profile/.env
#
# ℹ️ Для Docker используется также .env.docker (переопределяет хосты на имена контейнеров)
#   Локально: localhost, В Docker: postgres_profile, minio, и т.д.

# ─── База данных (для локального запуска без Docker) ───────────────────────────
# В Docker docker-compose подставит отдельные поля через environment:
PROFILE__DB__POSTGRES_USER=profile_admin
PROFILE__DB__POSTGRES_PASSWORD=profile_secret
PROFILE__DB__POSTGRES_SERVER=localhost
PROFILE__DB__POSTGRES_PORT=5433
PROFILE__DB__POSTGRES_DB=lorelounge_profile
PROFILE__DB__ECHO=false
PROFILE__DB__POOL_SIZE=20
PROFILE__DB__MAX_OVERFLOW=10

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
PROFILE__RABBITMQ__USER=guest
PROFILE__RABBITMQ__PASSWORD=guest
PROFILE__RABBITMQ__HOST=localhost
PROFILE__RABBITMQ__PORT=5672
PROFILE__RABBITMQ__VHOST=/
# Опционально можно задать полный URL (имеет приоритет над полями выше):
# PROFILE__RABBITMQ__URL=amqp://guest:guest@localhost:5672/

# ── MinIO (для локального запуска) ─────────────────────────────────────────────
# В Docker эти значения переопределяются из infra/docker-compose.yml
PROFILE__MINIO__ENDPOINT=localhost:9000
PROFILE__MINIO__ACCESS_KEY=admin
PROFILE__MINIO__SECRET_KEY=SuperSecret123!
PROFILE__MINIO__USE_SSL=false
PROFILE__MINIO__BUCKET_NAME=lorelounge-media
PROFILE__MINIO__BASE_PATH=profile

# ── Storage (Validation) ──────────────────────────────────────────────────────
PROFILE__STORAGE__ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif
PROFILE__STORAGE__MAX_FILE_SIZE_MB=5

# ── Infrastructure ────────────────────────────────────────────────────────────
PROFILE__RUN__SHOW_DOCS=true
