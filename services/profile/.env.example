# ─── Profile Service — Application Config ───────────────────────────────────────
# Этот файл читается:
#   1. Локально — pydantic-settings через dotenv
#   2. В Docker — через env_file в docker-compose.yml
#
# ❌ НЕ КОММИТЬ этот файл в git (он в .gitignore)
#    Используй .env.example как шаблон для команды

# ── База данных ───────────────────────────────────────────────────────────────
# Для локальной разработки (без Docker) — localhost
# В Docker — docker-compose подставит отдельные поля через environment:
# PROFILE_CONFIG__DB__POSTGRES_USER=profile_admin
# PROFILE_CONFIG__DB__POSTGRES_PASSWORD=profile_secret
# PROFILE_CONFIG__DB__POSTGRES_SERVER=localhost
# PROFILE_CONFIG__DB__POSTGRES_PORT=5432
# PROFILE_CONFIG__DB__POSTGRES_DB=lorelounge_profile


# ── Infrastructure ───────────────────────────────────────────────────────────
PROFILE_CONFIG__RUN__SHOW_DOCS=True

# ── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
