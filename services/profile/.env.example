# ─── Profile Service — Application Config ───────────────────────────────────────
# Этот файл читается:
#   1. Локально — pydantic-settings через dotenv
#   2. В Docker — через env_file в docker-compose.yml
#
# ❌ НЕ КОММИТЬ этот файл в git (он в .gitignore)
#    Используй .env.example как шаблон для команды

# ── База данных ───────────────────────────────────────────────────────────────
# Для локальной разработки (без Docker) — localhost
# В Docker — docker-compose подставит CONFIG__DB__URL через environment:
# CONFIG__DB__URL=postgresql+asyncpg://profile_admin:profile_secret@localhost:5432/lorelounge_profile


# ── Infrastructure ───────────────────────────────────────────────────────────
CONFIG__RUN__SHOW_DOCS=True

# ── RabbitMQ ─────────────────────────────────────────────────────────────────
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
