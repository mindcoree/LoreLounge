# ─── Profile Service — Docker-specific Config ────────────────────────────────
# Этот файл переопределяет значения из .env при запуске в Docker
# Используется в docker-compose через: env_file: [.env, .env.docker]
#
# 🔒 КОММИТИТСЯ в git (в отличие от .env)

# ── Docker-сеть: используются имена контейнеров вместо localhost ────────────────
PROFILE__DB__POSTGRES_SERVER=postgres_profile
PROFILE__DB__POSTGRES_PORT=5432
PROFILE__RABBITMQ__USER=guest
PROFILE__RABBITMQ__PASSWORD=guest
PROFILE__RABBITMQ__HOST=rabbitmq
PROFILE__RABBITMQ__PORT=5672
PROFILE__RABBITMQ__VHOST=/
PROFILE__MINIO__ENDPOINT=minio:9000
