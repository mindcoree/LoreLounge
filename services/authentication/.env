# ─── Auth Service — Application Config ───────────────────────────────────────
# Этот файл читается:
#   1. Локально — pydantic-settings через dotenv
#   2. В Docker — через env_file в docker-compose.yml
#
# ❌ НЕ КОММИТЬ этот файл в git (он в .gitignore)
#    Используй .env.example как шаблон для команды

# ── База данных ───────────────────────────────────────────────────────────────
# Для локальной разработки (без Docker) — localhost
# В Docker — docker-compose подставит CONFIG__DB__URL через environment:
# CONFIG__DB__URL=postgresql+asyncpg://auth_admin:auth_secret@localhost:5432/lorelounge_auth

# ── JWT ───────────────────────────────────────────────────────────────────────
CONFIG__AUTH__ACCESS_EXPIRE_MIN=15
CONFIG__AUTH__REFRESH_EXPIRE_DAYS=7

# ── Frontend URL (для ссылок в письмах) ──────────────────────────────────────
CONFIG__FRONTEND_URL=http://localhost:3000

# ── SMTP (заполни для отправки писем, иначе оставь пустым) ───────────────────
CONFIG__SMTP__HOST=
CONFIG__SMTP__PORT=587
CONFIG__SMTP__USER=
CONFIG__SMTP__PASSWORD=
CONFIG__SMTP__FROM_EMAIL=
