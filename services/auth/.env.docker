# ─── Auth Service — Docker-specific Config ────────────────────────────────────
# Этот файл переопределяет значения из .env при запуске в Docker
# Используется в docker-compose через: env_file: [.env, .env.docker]
#
# 🔒 КОММИТИТСЯ в git (в отличие от .env)

# ── Docker-сеть: используются имена контейнеров вместо localhost ────────────────
AUTH__DB__POSTGRES_SERVER=postgres_auth
AUTH__DB__POSTGRES_PORT=5432
AUTH__REDIS__URL=redis://:redis_secret@redis:6379/0
AUTH__RABBITMQ__URL=amqp://guest:guest@rabbitmq:5672/
