# ─── Auth Service — Application Config (ШАБЛОН) ──────────────────────────────
# Скопируй этот файл в .env и заполни значения:
#   cp services/auth/.env.example services/auth/.env
#
# ℹ️ Для Docker используется также .env.docker (переопределяет хосты на имена контейнеров)
#   Локально: localhost, В Docker: postgres_auth, redis_auth, rabbitmq, и т.д.

# ── База данных (только для локального запуска без Docker) ────────────────────
# В Docker docker-compose подставит AUTH__DB__POSTGRES_SERVER через environment:
AUTH__DB__POSTGRES_USER=auth_admin
AUTH__DB__POSTGRES_PASSWORD=auth_secret
AUTH__DB__POSTGRES_SERVER=localhost
AUTH__DB__POSTGRES_PORT=5432
AUTH__DB__POSTGRES_DB=lorelounge_auth
AUTH__DB__ECHO=false
AUTH__DB__POOL_SIZE=20
AUTH__DB__MAX_OVERFLOW=10

# ── Redis (для локального запуска) ────────────────────────────────────────────
# В Docker docker-compose подставит AUTH__REDIS__URL через environment:
AUTH__REDIS__URL=redis://:redis_auth_secret@localhost:6379/0

# ── JWT ────────────────────────────────────────────────────────────────────────
AUTH__AUTH__ACCESS_EXPIRE_MIN=15
AUTH__AUTH__REFRESH_EXPIRE_DAYS=7

# ── Frontend URL (для ссылок в письмах) ────────────────────────────────────────
AUTH__FRONTEND_URL=http://localhost

# ── Infrastructure ─────────────────────────────────────────────────────────────
AUTH__RUN__SHOW_DOCS=True

# ── RabbitMQ (для локального запуска) ──────────────────────────────────────────
# В Docker docker-compose подставит AUTH__RABBITMQ__URL через environment:
AUTH__RABBITMQ__URL=amqp://guest:guest@localhost:5672/
AUTH__RABBITMQ__USER=guest
AUTH__RABBITMQ__PASSWORD=guest
