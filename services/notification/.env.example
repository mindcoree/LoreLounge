# ─── Notification Service — Application Config (ШАБЛОН) ─────────────────────
# Скопируй этот файл в .env и заполни значения:
#   cp services/notification/.env.example services/notification/.env
#
# ℹ️ Для Docker используется также .env.docker (переопределяет хосты на имена контейнеров)
#   Локально: localhost, В Docker: rabbitmq, и т.д.

# ── RabbitMQ (для локального запуска) ─────────────────────────────────────────
# В Docker docker-compose подставит RABBITMQ_URL через environment:
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# ── SMTP Settings ──────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_TLS=True
SMTP_FROM=LoreLounge <no-reply@lorelounge.com>

