# ─── Content Service — Application Config ───────────────────────────────────────
# Этот файл читается:
#   1. Локально — pydantic-settings через dotenv
#   2. В Docker — через env_file в docker-compose.yml
#
# ❌ НЕ КОММИТЬ этот файл в git (он в .gitignore)
#    Используй .env.example как шаблон для команды


# ── База данных ───────────────────────────────────────────────────────────────
# Для локальной разработки (без Docker) — localhost
# В Docker — docker-compose подставит отдельные поля через environment:
CONTENT__DB__POSTGRES_USER=content_admin
CONTENT__DB__POSTGRES_PASSWORD=content_secret
CONTENT__DB__POSTGRES_SERVER=localhost
CONTENT__DB__POSTGRES_PORT=5433
CONTENT__DB__POSTGRES_DB=lorelounge_content
CONTENT__DB__ECHO=false
CONTENT__DB__POOL_SIZE=20
CONTENT__DB__MAX_OVERFLOW=10

CONTENT__RABBITMQ__USER=guest
CONTENT__RABBITMQ__PASSWORD=guest
CONTENT__RABBITMQ__HOST=localhost
CONTENT__RABBITMQ__PORT=5672
CONTENT__RABBITMQ__VHOST=/
# Опционально можно задать полный URL (имеет приоритет над полями выше):
# CONTENT__RABBITMQ__URL=amqp://guest:guest@localhost:5672/


CONTENT__MINIO__ENDPOINT=localhost:9000
CONTENT__MINIO__ACCESS_KEY=admin
CONTENT__MINIO__SECRET_KEY=SuperSecret123!
CONTENT__MINIO__USE_SSL=false
CONTENT__MINIO__BUCKET_NAME=lorelounge-media
CONTENT__MINIO__BASE_PATH=content

# ── Storage (Validation) ───────────────────────────────────────────────────
CONTENT__STORAGE__ALLOWED_MIME_TYPES=["image/jpeg", "image/png", "image/webp"]
CONTENT__STORAGE__MAX_FILE_SIZE_MB=5

# ── Infrastructure ───────────────────────────────────────────────────────────
CONTENT__RUN__SHOW_DOCS=true

