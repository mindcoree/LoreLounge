# ─── Content Service — Docker-specific Config ────────────────────────────────
# Этот файл переопределяет значения из .env при запуске в Docker
# Используется в docker-compose через: env_file: [.env, .env.docker]
#
# 🔒 КОММИТИТСЯ в git (в отличие от .env)

# ── Docker-сеть: используются имена контейнеров вместо localhost ────────────────
CONTENT__DB__POSTGRES_SERVER=postgres_content
CONTENT__DB__POSTGRES_PORT=5432
CONTENT__RABBITMQ__USER=guest
CONTENT__RABBITMQ__PASSWORD=guest
CONTENT__RABBITMQ__HOST=rabbitmq
CONTENT__RABBITMQ__PORT=5672
CONTENT__RABBITMQ__VHOST=/
CONTENT__MINIO__ENDPOINT=minio:9000
