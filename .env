# ─── Инфраструктура: только для docker-compose ────────────────────────────────
# Эти переменные нужны docker-compose для создания и настройки контейнеров.
# Приложения читают свои настройки из services/<name>/.env

# Auth Service DB
AUTH_DB_USER=auth_admin
AUTH_DB_PASSWORD=auth_secret
AUTH_DB_NAME=lorelounge_auth

# Auth Service Redis
REDIS_AUTH_PASSWORD=redis_auth_secret

# --- Будущие сервисы (добавляй по мере появления) ---
# CONTENT_DB_USER=content_admin
# CONTENT_DB_PASSWORD=content_secret
# CONTENT_DB_NAME=lorelounge_content
