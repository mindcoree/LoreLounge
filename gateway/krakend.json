{
  "$schema": "https://www.krakend.io/schema/v3.json",
  "version": 3,
  "name": "LoreLounge API Gateway",
  "port": 8080,
  "timeout": "5000ms",
  "cache_ttl": "300s",
  "output_encoding": "json",
  "endpoints": [
    {
      "endpoint": "/api/auth/register",
      "method": "POST",
      "output_encoding": "no-op",
      "input_headers": [
        "Content-Type",
        "Cookie"
      ],
      "backend": [
        {
          "url_pattern": "/api/v1/register",
          "encoding": "no-op",
          "sd": "static",
          "method": "POST",
          "host": ["http://auth-service:8000"]
        }
      ]
    },
    {
      "endpoint": "/api/auth/login",
      "method": "POST",
      "output_encoding": "no-op",
      "input_headers": [
        "Content-Type",
        "Cookie"
      ],
      "backend": [
        {
          "url_pattern": "/api/v1/login",
          "encoding": "no-op",
          "sd": "static",
          "method": "POST",
          "host": ["http://auth-service:8000"]
        }
      ]
    },
    {
      "endpoint": "/api/auth/logout",
      "method": "POST",
      "output_encoding": "no-op",
      "input_headers": [
        "Content-Type",
        "Cookie"
      ],
      "backend": [
        {
          "url_pattern": "/api/v1/logout",
          "encoding": "no-op",
          "sd": "static",
          "method": "POST",
          "host": ["http://auth-service:8000"]
        }
      ]
    },
    {
      "endpoint": "/api/auth/me",
      "method": "GET",
      "output_encoding": "no-op",
      "input_headers": [
        "Cookie"
      ],
      "backend": [
        {
          "url_pattern": "/api/v1/me",
          "encoding": "no-op",
          "sd": "static",
          "method": "GET",
          "host": ["http://auth-service:8000"]
        }
      ]
    },
    {
      "endpoint": "/api/auth/password-reset-request",
      "method": "POST",
      "output_encoding": "no-op",
      "input_headers": [
        "Content-Type",
        "Cookie"
      ],
      "backend": [
        {
          "url_pattern": "/api/v1/password-reset-request",
          "encoding": "no-op",
          "sd": "static",
          "method": "POST",
          "host": ["http://auth-service:8000"]
        }
      ]
    },
    {
      "endpoint": "/api/auth/password-reset-confirm",
      "method": "POST",
      "output_encoding": "no-op",
      "input_headers": [
        "Content-Type",
        "Cookie"
      ],
      "backend": [
        {
          "url_pattern": "/api/v1/password-reset-confirm",
          "encoding": "no-op",
          "sd": "static",
          "method": "POST",
          "host": ["http://auth-service:8000"]
        }
      ]
    },
    {
      "endpoint": "/api/auth/role-request",
      "method": "POST",
      "output_encoding": "no-op",
      "input_headers": [
        "Content-Type",
        "Cookie"
      ],
      "backend": [
        {
          "url_pattern": "/api/v1/role-request",
          "encoding": "no-op",
          "sd": "static",
          "method": "POST",
          "host": ["http://auth-service:8000"]
        }
      ]
    }
  ]
}
