{
  "$schema": "https://www.krakend.io/schema/v3.json",
  "version": 3,
  "name": "LoreLounge API Gateway",
  "port": 8080,
  "timeout": "5000ms",
  "output_encoding": "json",
  "endpoints": [
    {
      "endpoint": "/api/auth/register",
      "method": "POST",
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/api/v1/register",
          "host": ["http://auth:8000"]
        }
      ]
    },
    {
      "endpoint": "/api/auth/login",
      "method": "POST",
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/api/v1/login",
          "host": ["http://auth:8000"]
        }
      ]
    },
    {
      "endpoint": "/api/auth/logout",
      "method": "POST",
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/api/v1/logout",
          "host": ["http://auth:8000"]
        }
      ]
    },
    {
      "endpoint": "/api/auth/password-reset-request",
      "method": "POST",
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/api/v1/password-reset-request",
          "host": ["http://auth:8000"]
        }
      ]
    },
    {
      "endpoint": "/api/auth/password-reset-confirm",
      "method": "POST",
      "output_encoding": "no-op",
      "backend": [
        {
          "url_pattern": "/api/v1/password-reset-confirm",
          "host": ["http://auth:8000"]
        }
      ]
    },
    {
      "endpoint": "/api/auth/me",
      "method": "GET",
      "input_headers": ["Cookie", "x-user-id", "x-user-role", "x-user-email"],
      "extra_config": {
        "auth/validator": {
          "alg": "RS256",
          "jwk_url": "http://auth:8000/api/v1/.well-known/jwks.json",
          "disable_jwk_security": true,
          "cookie_name": "access_token",
          "propagate_claims": [
            ["sub", "x-user-id"],
            ["role", "x-user-role"],
            ["email", "x-user-email"]
          ]
        }
      },
      "backend": [
        {
          "url_pattern": "/api/v1/me",
          "host": ["http://auth:8000"]
        }
      ]
    },
    {
      "endpoint": "/api/auth/role-request",
      "method": "POST",
      "input_headers": ["Content-Type", "Cookie", "x-user-id", "x-user-role", "x-user-email"],
      "extra_config": {
        "auth/validator": {
          "alg": "RS256",
          "jwk_url": "http://auth:8000/api/v1/.well-known/jwks.json",
          "disable_jwk_security": true,
          "cookie_name": "access_token",
          "propagate_claims": [
            ["sub", "x-user-id"],
            ["role", "x-user-role"],
            ["email", "x-user-email"]
          ]
        }
      },
      "backend": [
        {
          "url_pattern": "/api/v1/role-request",
          "host": ["http://auth:8000"]
        }
      ]
    },
    {
      "endpoint": "/api/v1/role-requests/",
      "method": "GET",
      "input_headers": ["Cookie", "x-user-id", "x-user-role", "x-user-email"],
      "extra_config": {
        "auth/validator": {
          "alg": "RS256",
          "jwk_url": "http://auth:8000/api/v1/.well-known/jwks.json",
          "disable_jwk_security": true,
          "cookie_name": "access_token",
          "propagate_claims": [
            ["sub", "x-user-id"],
            ["role", "x-user-role"],
            ["email", "x-user-email"]
          ]
        }
      },
      "backend": [
        {
          "url_pattern": "/api/v1/role-requests/",
          "host": ["http://auth:8000"]
        }
      ]
    },
    {
      "endpoint": "/api/v1/role-requests/{request_id}/approve",
      "method": "POST",
      "input_headers": ["Cookie", "x-user-id", "x-user-role", "x-user-email"],
      "extra_config": {
        "auth/validator": {
          "alg": "RS256",
          "jwk_url": "http://auth:8000/api/v1/.well-known/jwks.json",
          "disable_jwk_security": true,
          "cookie_name": "access_token",
          "propagate_claims": [
            ["sub", "x-user-id"],
            ["role", "x-user-role"],
            ["email", "x-user-email"]
          ]
        }
      },
      "backend": [
        {
          "url_pattern": "/api/v1/role-requests/{request_id}/approve",
          "host": ["http://auth:8000"]
        }
      ]
    },
    {
      "endpoint": "/api/v1/role-requests/{request_id}/reject",
      "method": "POST",
      "input_headers": ["Cookie", "x-user-id", "x-user-role", "x-user-email"],
      "extra_config": {
        "auth/validator": {
          "alg": "RS256",
          "jwk_url": "http://auth:8000/api/v1/.well-known/jwks.json",
          "disable_jwk_security": true,
          "cookie_name": "access_token",
          "propagate_claims": [
            ["sub", "x-user-id"],
            ["role", "x-user-role"],
            ["email", "x-user-email"]
          ]
        }
      },
      "backend": [
        {
          "url_pattern": "/api/v1/role-requests/{request_id}/reject",
          "host": ["http://auth:8000"]
        }
      ]
    }
  ]
}