# ── Shared infrastructure variables for docker compose ─────────────────────────
# Copy to .env in the repository root for local docker runs.

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=SuperSecret123!
MINIO_USE_SSL=false
MINIO_BUCKET=lorelounge-media

# service overrides (optional)
MINIO_BUCKET_PROFILE=lorelounge-media
MINIO_PREFIX_PROFILE=profile
